{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/seo/research-competitors.ts": {
      "maxDuration": 60
    },
    "api/seo/generate-page.ts": {
      "maxDuration": 60
    },
    "api/seo/refresh-images.ts": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://*.elfsight.com https://va.vercel-scripts.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://*.elfsight.com https://vitals.vercel-insights.com https://stream.mux.com; media-src 'self' blob: https://stream.mux.com https://videos.pexels.com; frame-src https://*.elfsight.com; object-src 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/social-engineering",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/social-engineering/:path*",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/services",
      "destination": "/services/index.html"
    },
    {
      "source": "/pricing",
      "destination": "/pricing/index.html"
    },
    {
      "source": "/contact",
      "destination": "/contact/index.html"
    },
    {
      "source": "/why-us",
      "destination": "/why-us/index.html"
    },
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/support",
      "destination": "/support/index.html"
    },
    {
      "source": "/status",
      "destination": "/status/index.html"
    },
    {
      "source": "/cybersecurity",
      "destination": "/cybersecurity/index.html"
    },
    {
      "source": "/codenest",
      "destination": "/codenest/index.html"
    },
    {
      "source": "/blog",
      "destination": "/blog/index.html"
    },
    {
      "source": "/service-category/cybersecurity",
      "destination": "/service-category/cybersecurity/index.html"
    },
    {
      "source": "/service-category/live-it-support",
      "destination": "/service-category/live-it-support/index.html"
    },
    {
      "source": "/service-category/it-repair-upgrades",
      "destination": "/service-category/it-repair-upgrades/index.html"
    },
    {
      "source": "/service-category/managed-it-services",
      "destination": "/service-category/managed-it-services/index.html"
    },
    {
      "source": "/service-category/cloud-solutions",
      "destination": "/service-category/cloud-solutions/index.html"
    },
    {
      "source": "/service-category/network-infrastructure",
      "destination": "/service-category/network-infrastructure/index.html"
    },
    {
      "source": "/service-category/family-offices",
      "destination": "/service-category/family-offices/index.html"
    },
    {
      "source": "/service-category/healthcare",
      "destination": "/service-category/healthcare/index.html"
    },
    {
      "source": "/service-category/luxury",
      "destination": "/service-category/luxury/index.html"
    },
    {
      "source": "/service-category/cellular-das-and-public-safety",
      "destination": "/service-category/cellular-das-and-public-safety/index.html"
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy-policy/index.html"
    },
    {
      "source": "/terms-and-conditions",
      "destination": "/terms-and-conditions/index.html"
    },
    {
      "source": "/cookie-policy",
      "destination": "/cookie-policy/index.html"
    },
    {
      "source": "/l/cybersecurity-guide",
      "destination": "/l/cybersecurity-guide/index.html"
    },
    {
      "source": "/l/it-support-guide",
      "destination": "/l/it-support-guide/index.html"
    },
    {
      "source": "/l/it-repair-guide",
      "destination": "/l/it-repair-guide/index.html"
    },
    {
      "source": "/l/managed-it-guide",
      "destination": "/l/managed-it-guide/index.html"
    },
    {
      "source": "/l/cloud-solutions-guide",
      "destination": "/l/cloud-solutions-guide/index.html"
    },
    {
      "source": "/l/network-infrastructure-guide",
      "destination": "/l/network-infrastructure-guide/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
