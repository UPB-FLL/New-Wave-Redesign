VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
RESEND_API_KEY=your_resend_api_key
OPENAI_API_KEY=your_openai_api_key
PEXELS_API_KEY=your_pexels_api_key

# Optional: Set both to the same secret to protect AI/SEO API endpoints from unauthorized use.
# When set, requests to /api/seo/* must include an x-admin-key header matching this value.
ADMIN_API_KEY=your_secret_admin_key
VITE_ADMIN_API_KEY=your_secret_admin_key

# ---------------------------------------------------------------------------
# Support page (/support)
# ---------------------------------------------------------------------------

# Server-side Supabase access. The support API routes read and write the
# support_* tables, which have RLS on and no public policies, so they need the
# service-role key. NEVER expose this to the browser / never prefix it VITE_.
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Email section ---------------------------------------------------------
# Where the "Email support" form delivers, and the verified Resend sender it
# comes from. Both are optional; the defaults below are used when unset.
SUPPORT_INBOX_EMAIL=support@newwaveitfl.com
SUPPORT_FROM_EMAIL=New Wave IT Support <support@newwaveitfl.com>

# --- Customer login (SuperOps) ---------------------------------------------
# GraphQL API token from SuperOps: Settings -> My Profile -> API token.
SUPEROPS_API_TOKEN=your_superops_api_token
# Your SuperOps subdomain, sent as the CustomerSubDomain header.
SUPEROPS_SUBDOMAIN=your_superops_subdomain
# Data centre your SuperOps account lives in: "us" (default) or "eu".
SUPEROPS_DATA_CENTER=us
# Optional override. Defaults to https://api.superops.ai/msp (US) or
# https://euapi.superops.ai/msp (EU).
SUPEROPS_API_URL=
# Link on the support page to the full SuperOps client portal.
VITE_SUPEROPS_PORTAL_URL=https://super-ops.newwaveitfl.com

# --- Live chat -> SMS bridge (Twilio) --------------------------------------
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Use a Messaging Service (preferred) or a single sending number.
TWILIO_MESSAGING_SERVICE_SID=your_twilio_messaging_service_sid
TWILIO_FROM_NUMBER=+19545550100
# Technician cell number(s) that receive chat messages. Comma-separated,
# E.164 format. Replies from any other number are rejected.
SUPPORT_AGENT_SMS_NUMBERS=+19545550101
# Optional. Set this when Twilio's signature check fails behind a proxy or a
# custom domain — it must exactly match the webhook URL configured in Twilio.
SUPPORT_SMS_WEBHOOK_URL=https://www.newwaveitfl.com/api/support/sms-webhook
